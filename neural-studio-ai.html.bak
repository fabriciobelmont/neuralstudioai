<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Neural Studio AI™ — Retratos Ejecutivos con IA</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#07070d;
  --bg2:#0f0f1a;
  --bgc:#12121f;
  --purple:#7c3aed;
  --purpleL:#a855f7;
  --cyan:#00d4ff;
  --green:#39ff14;
  --white:#ffffff;
  --gray:#9ca3af;
  --muted:#6b7280;
  --border:rgba(255,255,255,0.06);
  --borderP:rgba(124,58,237,0.35);
  --borderC:rgba(0,212,255,0.25);
  --font-d:'Outfit',sans-serif;
  --font-b:'Inter',sans-serif;
}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--white);font-family:var(--font-b);line-height:1.7;overflow-x:hidden}
img{max-width:100%;display:block}
a{text-decoration:none;color:inherit}

/* UTILITIES */
.container{max-width:1180px;margin:0 auto;padding:0 24px}
.eyebrow{font-family:var(--font-d);font-size:11px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--purpleL);display:block;margin-bottom:14px}
.grad-text{background:linear-gradient(135deg,#a855f7 0%,#00d4ff 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.divider{width:56px;height:3px;background:linear-gradient(90deg,var(--purple),var(--cyan));border-radius:100px;margin:14px auto 32px}
section{padding:96px 0;position:relative}
.reveal{opacity:0;transform:translateY(28px);transition:opacity .65s ease,transform .65s ease}
.reveal.visible{opacity:1;transform:translateY(0)}

/* GLOW BG */
.glow-top::before{content:'';position:absolute;top:0;left:50%;transform:translateX(-50%);width:700px;height:320px;background:radial-gradient(ellipse,rgba(124,58,237,.18) 0%,transparent 65%);pointer-events:none;z-index:0}
.glow-center::before{content:'';position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:600px;height:400px;background:radial-gradient(ellipse,rgba(124,58,237,.13) 0%,transparent 65%);pointer-events:none;z-index:0}

/* NAVBAR */
nav{position:fixed;top:0;left:0;right:0;z-index:100;background:rgba(7,7,13,.88);backdrop-filter:blur(16px);border-bottom:1px solid var(--border);padding:14px 0}
.nav-inner{display:flex;align-items:center;justify-content:space-between;max-width:1180px;margin:0 auto;padding:0 24px}
.logo{font-family:var(--font-d);font-size:18px;font-weight:800;display:flex;align-items:center;gap:8px;letter-spacing:-.01em}
.logo span{background:linear-gradient(135deg,#a855f7,#00d4ff);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.logo-dot{width:8px;height:8px;border-radius:50%;background:var(--green);box-shadow:0 0 8px var(--green);animation:pulse-dot 2s ease-in-out infinite}
@keyframes pulse-dot{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.6;transform:scale(.85)}}
.nav-cta{font-family:var(--font-d);font-size:13px;font-weight:700;padding:9px 22px;border-radius:100px;background:linear-gradient(135deg,var(--purple),#6d28d9);color:#fff;letter-spacing:.02em;transition:opacity .2s,box-shadow .2s}
.nav-cta:hover{opacity:.9;box-shadow:0 0 24px rgba(124,58,237,.5)}

/* HERO */
#hero{padding-top:140px;padding-bottom:80px;min-height:100vh;display:flex;align-items:center}
.hero-inner{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center;position:relative;z-index:1}
.hero-badge{display:inline-flex;align-items:center;gap:8px;background:rgba(124,58,237,.12);border:1px solid var(--borderP);border-radius:100px;padding:6px 16px;font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--purpleL);margin-bottom:24px}
.hero-badge .dot{width:6px;height:6px;border-radius:50%;background:var(--green);box-shadow:0 0 6px var(--green);animation:pulse-dot 2s ease-in-out infinite}
h1{font-family:var(--font-d);font-size:52px;font-weight:900;line-height:1.08;letter-spacing:-.02em;margin-bottom:22px}
.hero-sub{font-size:17px;color:var(--gray);max-width:480px;margin-bottom:36px;line-height:1.65}
.cta-btn{display:inline-flex;align-items:center;gap:10px;font-family:var(--font-d);font-size:16px;font-weight:800;padding:18px 36px;border-radius:14px;background:linear-gradient(135deg,#7c3aed 0%,#6d28d9 60%,#5b21b6 100%);color:#fff;letter-spacing:.03em;box-shadow:0 0 40px rgba(124,58,237,.55),0 8px 24px rgba(0,0,0,.4);transition:transform .2s,box-shadow .2s;border:none;cursor:pointer;text-transform:uppercase}
.cta-btn:hover{transform:translateY(-2px);box-shadow:0 0 56px rgba(124,58,237,.7),0 12px 32px rgba(0,0,0,.5)}
.cta-microcopy{display:flex;align-items:center;gap:20px;margin-top:16px;font-size:12px;color:var(--muted)}
.cta-microcopy span{display:flex;align-items:center;gap:5px}
.cta-microcopy span::before{content:'✓';color:var(--green);font-weight:700}
.hero-img{position:relative}
.hero-img img{border-radius:20px;width:100%;box-shadow:0 0 80px rgba(124,58,237,.3),0 32px 64px rgba(0,0,0,.6)}
.hero-img::after{content:'';position:absolute;inset:-1px;border-radius:21px;background:linear-gradient(135deg,rgba(124,58,237,.4),rgba(0,212,255,.15));z-index:-1;filter:blur(20px)}

/* PRICE HERO */
.price-box{display:inline-flex;align-items:center;gap:14px;background:rgba(124,58,237,.1);border:1px solid var(--borderP);border-radius:12px;padding:12px 20px;margin-bottom:24px}
.price-old{font-size:14px;color:var(--muted);text-decoration:line-through;font-family:var(--font-d)}
.price-new{font-size:28px;font-weight:900;font-family:var(--font-d);background:linear-gradient(135deg,#a855f7,#00d4ff);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.price-label{font-size:11px;color:var(--gray);font-weight:600}

/* SECTION TITLES */
.section-head{text-align:center;margin-bottom:56px}
.section-head h2{font-family:var(--font-d);font-size:40px;font-weight:800;line-height:1.15;letter-spacing:-.02em}

/* ANTES/DEPOIS */
#antes{background:var(--bg2)}
.antes-img{border-radius:16px;overflow:hidden;box-shadow:0 0 60px rgba(124,58,237,.2),0 24px 48px rgba(0,0,0,.5)}

/* IA VS */
#ia-vs{background:var(--bg)}
.ia-img{border-radius:16px;overflow:hidden;box-shadow:0 0 60px rgba(0,212,255,.15),0 24px 48px rgba(0,0,0,.5);width:100%}

/* MECANISMO */
#mecanismo{background:var(--bg2)}
.mec-img{border-radius:16px;overflow:hidden;width:100%;box-shadow:0 0 80px rgba(124,58,237,.25),0 32px 64px rgba(0,0,0,.6)}

/* COMO FUNCIONA */
#como{background:var(--bg)}
.como-img{border-radius:16px;overflow:hidden;width:100%;box-shadow:0 0 60px rgba(124,58,237,.2),0 24px 48px rgba(0,0,0,.5)}

/* PROFISSOES */
#profissoes{background:var(--bg2);padding:80px 0}
.prof-img{border-radius:16px;overflow:hidden;width:100%;box-shadow:0 0 80px rgba(124,58,237,.25),0 32px 64px rgba(0,0,0,.6)}

/* BONUS */
#bonus{background:var(--bg)}
.bonus-header{text-align:center;margin-bottom:16px}
.bonus-value-total{text-align:center;margin-bottom:48px}
.bonus-value-total p{font-size:14px;color:var(--muted)}
.bonus-value-total strong{color:var(--purpleL)}
.bonus-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px}
.bonus-card{background:linear-gradient(135deg,var(--bgc) 0%,var(--bg2) 100%);border:1px solid rgba(124,58,237,.4);border-radius:18px;padding:32px;position:relative;overflow:hidden;transition:transform .3s,box-shadow .3s}
.bonus-card:hover{transform:translateY(-4px);box-shadow:0 0 48px rgba(124,58,237,.25)}
.bonus-card::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,#7c3aed,#00d4ff)}
.bonus-badge{display:inline-block;background:rgba(124,58,237,.15);border:1px solid rgba(124,58,237,.4);color:var(--purpleL);padding:4px 14px;border-radius:100px;font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;margin-bottom:18px}
.bonus-img{border-radius:12px;overflow:hidden;margin-bottom:20px;border:1px solid var(--borderP)}
.bonus-img img{width:100%}
.bonus-title{font-family:var(--font-d);font-size:20px;font-weight:700;margin-bottom:12px;line-height:1.3}
.bonus-list{list-style:none;display:flex;flex-direction:column;gap:8px}
.bonus-list li{font-size:14px;color:var(--gray);display:flex;align-items:flex-start;gap:8px;line-height:1.5}
.bonus-list li::before{content:'✓';color:var(--green);font-weight:700;flex-shrink:0;margin-top:1px}
.bonus-value-tag{display:flex;align-items:center;gap:8px;margin-top:18px;padding-top:18px;border-top:1px solid var(--border)}
.bvt-old{font-size:13px;color:var(--muted);text-decoration:line-through}
.bvt-free{font-size:14px;font-weight:700;color:var(--green);font-family:var(--font-d)}

/* WHATSAPP PROOFS */
#proofs{background:var(--bg2)}
.proof-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.proof-frame{border-radius:24px;overflow:hidden;border:1px solid var(--border);box-shadow:0 16px 48px rgba(0,0,0,.5)}
.proof-frame img{width:100%;display:block}

/* GARANTIA */
#garantia{background:var(--bg)}
.garantia-inner{display:flex;flex-direction:column;align-items:center;text-align:center}
.garantia-img{width:260px;margin-bottom:32px;filter:drop-shadow(0 0 40px rgba(124,58,237,.4))}
.garantia-text{max-width:540px}
.garantia-text h2{font-family:var(--font-d);font-size:32px;font-weight:800;margin-bottom:14px}
.garantia-text p{font-size:16px;color:var(--gray);line-height:1.7}

/* CTA FINAL */
#cta-final{padding:80px 0;position:relative;overflow:hidden}
#cta-final::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 50% 50%,rgba(124,58,237,.22) 0%,transparent 65%);pointer-events:none}
.cta-final-inner{position:relative;z-index:1;text-align:center;max-width:760px;margin:0 auto}
.cta-img{border-radius:20px;overflow:hidden;margin-bottom:40px;box-shadow:0 0 80px rgba(124,58,237,.3),0 32px 64px rgba(0,0,0,.6)}
.cta-final-inner h2{font-family:var(--font-d);font-size:44px;font-weight:900;line-height:1.1;letter-spacing:-.02em;margin-bottom:16px}
.cta-final-inner p{font-size:17px;color:var(--gray);margin-bottom:32px}
.price-stack{margin-bottom:32px}
.price-stack .from{font-size:15px;color:var(--muted);text-decoration:line-through;font-family:var(--font-d)}
.price-stack .to-label{font-size:14px;color:var(--gray);margin:4px 0}
.price-stack .amount{font-family:var(--font-d);font-size:64px;font-weight:900;line-height:1;background:linear-gradient(135deg,#a855f7,#00d4ff);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.price-stack .installment{font-size:14px;color:var(--muted);margin-top:6px}
.countdown-box{display:inline-flex;align-items:center;gap:12px;background:rgba(124,58,237,.1);border:1px solid var(--borderP);border-radius:12px;padding:10px 20px;margin-bottom:28px;font-family:var(--font-d);font-size:14px;font-weight:600}
.countdown{font-size:22px;font-weight:900;color:var(--purpleL);letter-spacing:.04em}
.cta-security{display:flex;align-items:center;justify-content:center;gap:20px;margin-top:16px;font-size:12px;color:var(--muted)}
.cta-security span{display:flex;align-items:center;gap:5px}

/* FOOTER */
footer{padding:32px 0;border-top:1px solid var(--border);text-align:center}
footer .f-logo{font-family:var(--font-d);font-size:16px;font-weight:800;margin-bottom:10px}
footer p{font-size:12px;color:var(--muted)}

/* STICKY MOBILE CTA */
.sticky-mobile{display:none;position:fixed;bottom:0;left:0;right:0;padding:12px 16px 16px;background:rgba(7,7,13,.96);backdrop-filter:blur(12px);border-top:1px solid rgba(124,58,237,.3);z-index:200}
.sticky-mobile .cta-btn{width:100%;justify-content:center;font-size:15px;padding:16px 24px}

@media(max-width:900px){
  .hero-inner{grid-template-columns:1fr;gap:40px;text-align:center}
  .hero-sub{margin-left:auto;margin-right:auto}
  .cta-microcopy{justify-content:center;flex-wrap:wrap;gap:12px}
  .hero-img{order:-1}
  h1{font-size:38px}
  .bonus-grid{grid-template-columns:1fr}
  .proof-grid{grid-template-columns:1fr;gap:16px}
  .cta-final-inner h2{font-size:32px}
  .price-stack .amount{font-size:48px}
  .sticky-mobile{display:block}
  body{padding-bottom:80px}
  section{padding:72px 0}
}
@media(max-width:600px){
  h1{font-size:32px}
  .section-head h2{font-size:28px}
}
</style>
</head>
<body>

<!-- NAV -->
<nav>
  <div class="nav-inner">
    <div class="logo">
      <div class="logo-dot"></div>
      Neural Studio <span>AI™</span>
    </div>
    <a href="#cta-final" class="nav-cta">Obtener Acceso — $9.90</a>
  </div>
</nav>

<!-- HERO -->
<section id="hero" class="glow-top">
  <div class="container">
    <div class="hero-inner">
      <div class="hero-content">
        <div class="hero-badge reveal">
          <div class="dot"></div>
          Neural Studio AI™ — Sistema Activo
        </div>
        <div class="price-box reveal">
          <div>
            <div class="price-old">Precio normal $47</div>
            <div class="price-label">Precio de lanzamiento</div>
          </div>
          <div class="price-new">$9.90</div>
        </div>
        <h1 class="reveal">Convierte selfies comunes en retratos de <span class="grad-text">autoridad.</span></h1>
        <p class="hero-sub reveal">El sistema de prompts cinematográficos que transforma cualquier foto en un retrato ejecutivo hiperrealista — en segundos.</p>
        <a href="#cta-final" class="cta-btn reveal">⚡ Quiero Acceso Ahora</a>
        <div class="cta-microcopy reveal">
          <span>Acceso inmediato</span>
          <span>Garantía 15 días</span>
          <span>Sin mensualidad</span>
        </div>
      </div>
      <div class="hero-img reveal">
        <img src="data:image/png;base64," alt="Retrato ejecutivo generado con Neural Studio AI" loading="eager">
      </div>
    </div>
  </div>
</section>

<!-- ANTES/DEPOIS -->
<section id="antes" class="glow-center">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Transformación real</span>
      <h2>De selfie común a <span class="grad-text">retrato ejecutivo</span></h2>
      <div class="divider"></div>
    </div>
    <div class="antes-img reveal">
      <img src="data:image/png;base64," alt="Antes y después — selfie a retrato ejecutivo">
    </div>
  </div>
</section>

<!-- IA GENERICA VS NEURAL STUDIO -->
<section id="ia-vs">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">La diferencia importa</span>
      <h2>IA normal <span class="grad-text">vs</span> Neural Studio AI™</h2>
      <div class="divider"></div>
      <p style="color:var(--gray);max-width:560px;margin:0 auto;font-size:16px">La mayoría genera imágenes que parecen falsas.<br>Nuestro sistema genera <strong style="color:var(--white)">autoridad visual real.</strong></p>
    </div>
    <div class="reveal">
      <img class="ia-img" src="data:image/png;base64," alt="IA Normal vs Neural Studio AI — comparación">
    </div>
  </div>
</section>

<!-- MECANISMO ÚNICO -->
<section id="mecanismo" class="glow-top">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Tecnología exclusiva</span>
      <h2>El mecanismo detrás de los<br><span class="grad-text">retratos hiperrealistas</span></h2>
      <div class="divider"></div>
    </div>
    <div class="reveal">
      <img class="mec-img" src="data:image/png;base64," alt="Mecanismo único del sistema Neural Studio">
    </div>
  </div>
</section>

<!-- COMO FUNCIONA -->
<section id="como">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">3 pasos simples</span>
      <h2>Tu transformación en <span class="grad-text">minutos</span></h2>
      <div class="divider"></div>
    </div>
    <div class="reveal">
      <img class="como-img" src="data:image/png;base64," alt="Cómo funciona — Sube selfie, copia código, genera retrato">
    </div>
  </div>
</section>

<!-- PROFISSOES -->
<section id="profissoes">
  <div class="container">
    <div class="reveal">
      <img class="prof-img" src="data:image/png;base64," alt="Ideal para profesionales — doctora, abogada, coach, consultora">
    </div>
  </div>
</section>

<!-- BONUS -->
<section id="bonus" class="glow-top">
  <div class="container">
    <div class="bonus-header reveal">
      <span class="eyebrow">Incluido hoy sin costo adicional</span>
      <h2 style="font-family:var(--font-d);font-size:40px;font-weight:800;line-height:1.15;letter-spacing:-.02em">Hoy también recibes estos <span class="grad-text">Bonos Premium</span></h2>
      <div class="divider"></div>
    </div>
    <div class="bonus-value-total reveal">
      <p>Valor total de los bonos: <strong>$47</strong> — <span style="color:var(--green);font-weight:700">GRATIS para ti hoy</span></p>
    </div>
    <div class="bonus-grid">
      <div class="bonus-card reveal">
        <div class="bonus-badge">Bono #1 — Valor: $27</div>
        <div class="bonus-img">
          <img src="data:image/png;base64," alt="Neural Studio Premium — Bono">
        </div>
        <h3 class="bonus-title">Neural Studio AI™<br><span class="grad-text">Sistema Completo</span></h3>
        <ul class="bonus-list">
          <li>Generador de prompts cinematográficos para cualquier IA de imagen</li>
          <li>Biblioteca de 8 categorías: Fotos Pro, Corporativo, Productos, Moda y más</li>
          <li>Genera sesiones completas de 30 variaciones con un clic</li>
          <li>Acceso a todos los formatos: cuadrado, retrato, story, paisaje</li>
        </ul>
        <div class="bonus-value-tag">
          <span class="bvt-old">$27</span>
          <span class="bvt-free">✓ GRATIS</span>
        </div>
      </div>
      <div class="bonus-card reveal">
        <div class="bonus-badge">Bono #2 — Valor: $20</div>
        <div class="bonus-img">
          <img src="data:image/png;base64," alt="Parámetros cinematográficos — Bono">
        </div>
        <h3 class="bonus-title">Parámetros de Fotografía<br><span class="grad-text">Ultra Premium</span></h3>
        <ul class="bonus-list">
          <li>Configuración completa: lente 85mm, apertura f1.8, ISO 400, iluminación Rembrandt</li>
          <li>Modo cinematográfico con colores profundos y alto contraste</li>
          <li>Textura de piel realista — sin plasticidad artificial</li>
          <li>Output en RAW + JPEG, 8192x1024px, calidad Ultra Premium</li>
        </ul>
        <div class="bonus-value-tag">
          <span class="bvt-old">$20</span>
          <span class="bvt-free">✓ GRATIS</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- WHATSAPP PROOFS -->
<section id="proofs">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Resultados reales</span>
      <h2>Lo que dicen cuando ven <span class="grad-text">los resultados</span></h2>
      <div class="divider"></div>
    </div>
    <div class="proof-grid">
      <div class="proof-frame reveal">
        <img src="data:image/png;base64," alt="Testimonio WhatsApp 1">
      </div>
      <div class="proof-frame reveal">
        <img src="data:image/png;base64," alt="Testimonio WhatsApp 2">
      </div>
      <div class="proof-frame reveal">
        <img src="data:image/png;base64," alt="Testimonio WhatsApp 3">
      </div>
    </div>
  </div>
</section>

<!-- GARANTIA -->
<section id="garantia" class="glow-center">
  <div class="container">
    <div class="garantia-inner reveal">
      <img class="garantia-img" src="data:image/png;base64," alt="15 días de garantía — Satisfacción total">
      <div class="garantia-text">
        <h2>Garantía de <span class="grad-text">Satisfacción Total</span></h2>
        <p>Si en los próximos <strong style="color:var(--white)">15 días</strong> no estás completamente satisfecho con los resultados, te devolvemos el 100% de tu dinero. Sin preguntas. Sin complicaciones. Riesgo cero para ti.</p>
      </div>
    </div>
  </div>
</section>

<!-- CTA FINAL -->
<section id="cta-final">
  <div class="container">
    <div class="cta-final-inner">
      <div class="cta-img reveal">
        <img src="data:image/png;base64," alt="Neural Studio AI — Haz que tu perfil transmita autoridad hoy">
      </div>
      <span class="eyebrow reveal">Oferta de lanzamiento</span>
      <h2 class="reveal">Tu imagen digital ya no puede verse <span class="grad-text">amateur.</span></h2>
      <p class="reveal">Imágenes que hablan por ti, incluso antes de que digas una palabra.</p>
      <div class="countdown-box reveal">
        <span style="color:var(--gray);font-size:13px">⏱ Oferta expira en:</span>
        <span class="countdown" id="countdown">00:29:59</span>
      </div>
      <div class="price-stack reveal">
        <div class="from">Precio normal: $47.00</div>
        <div class="to-label">Precio de lanzamiento</div>
        <div class="amount">$9.90</div>
        <div class="installment">Acceso único · Sin mensualidad · Sin renovaciones</div>
      </div>
      <a href="#" class="cta-btn reveal" style="font-size:18px;padding:20px 48px;border-radius:16px;display:inline-flex">⚡ QUIERO ACCESO AHORA</a>
      <div class="cta-security reveal">
        <span>🔒 Pago 100% seguro</span>
        <span>⚡ Acceso inmediato</span>
        <span>🛡 Garantía 15 días</span>
      </div>
    </div>
  </div>
</section>

<!-- FOOTER -->
<footer>
  <div class="container">
    <div class="f-logo">Neural Studio <span class="grad-text">AI™</span></div>

  </div>
</footer>

<!-- STICKY MOBILE CTA -->
<div class="sticky-mobile">
  <a href="#cta-final" class="cta-btn">⚡ Acceso por solo $9.90</a>
</div>

<script>
// Scroll reveal
const obs = new IntersectionObserver((entries) => {
  entries.forEach(e => { if(e.isIntersecting) e.target.classList.add('visible'); });
}, {threshold:0.12});
document.querySelectorAll('.reveal').forEach(el => obs.observe(el));

// Countdown
function initCountdown() {
  let deadline = sessionStorage.getItem('ns_deadline');
  if (!deadline) {
    deadline = Date.now() + 30 * 60 * 1000;
    sessionStorage.setItem('ns_deadline', deadline);
  }
  const update = () => {
    const rem = parseInt(deadline) - Date.now();
    if (rem <= 0) { document.getElementById('countdown').textContent = '00:00:00'; return; }
    const m = Math.floor(rem / 60000).toString().padStart(2,'0');
    const s = Math.floor((rem % 60000) / 1000).toString().padStart(2,'0');
    document.getElementById('countdown').textContent = '00:' + m + ':' + s;
  };
  update();
  setInterval(update, 1000);
}
initCountdown();
</script>
</body>
</html>